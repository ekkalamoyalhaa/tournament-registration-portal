// Tournament Registration Portal — data model
// Reflects PRD sections 6, 19, 20, 30, 31.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum GlobalRole {
  TEAM_MANAGER
  TEAM_STAFF
  TOURNAMENT_ADMIN
  SUPER_ADMIN
}

enum TournamentStatus {
  DRAFT
  OPEN_FOR_REGISTRATION
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum RegistrationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  RESUBMITTED
  APPROVED
  REJECTED
}

enum PlayerStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DocumentVisibility {
  PUBLIC
  PRIVATE
}

// ---------- Identity ----------

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  emailVerifiedAt   DateTime?
  passwordHash      String
  firstName         String
  lastName          String
  phone             String?
  role              GlobalRole @default(TEAM_MANAGER)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  teamMemberships   TeamMembership[]
  auditLogs         AuditLog[]
  sessions          Session[]
  accounts          Account[]

  @@map("users")
}

// Auth.js required tables
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ---------- Tournament ----------

model Tournament {
  id                    String            @id @default(uuid())
  slug                  String            @unique
  name                  String
  description           String?
  logoStorageKey        String?
  bannerStorageKey      String?
  venue                 String?
  startDate             DateTime?
  endDate               DateTime?
  registrationOpensAt   DateTime?
  registrationClosesAt  DateTime?
  status                TournamentStatus  @default(DRAFT)
  availableTeamSlots    Int?
  minPlayers            Int?
  maxPlayers            Int?
  rules                 String?
  eligibility           String?
  contactInfo           String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  requirements          TournamentRequirement[]
  registrations         TeamRegistration[]
  fixtures              Fixture[]
  announcements         Announcement[]
  venues                Venue[]

  @@map("tournaments")
}

// Configurable per-tournament requirements (PRD §13, §14)
model TournamentRequirement {
  id           String     @id @default(uuid())
  tournamentId String
  fieldKey     String     // e.g. "player.dateOfBirth", "document.passport"
  fieldLabel   String
  isRequired   Boolean    @default(true)
  category     String     // "player_field" | "document"

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, fieldKey])
  @@map("tournament_requirements")
}

model Venue {
  id           String     @id @default(uuid())
  tournamentId String
  name         String
  address      String?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  fixtures   Fixture[]

  @@map("venues")
}

// ---------- Team ----------

model Team {
  id                String   @id @default(uuid())
  name              String
  shortName         String?
  clubRegistrationNumber String?
  country           String?
  region            String?
  city              String?
  address           String?
  contactEmail      String?
  contactPhone      String?
  website           String?
  socialMedia       String?
  description       String?
  logoStorageKey    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  members       TeamMembership[]
  registrations TeamRegistration[]
  documents     TeamDocument[]
  players       Player[]

  @@map("teams")
}

model TeamMembership {
  id       String   @id @default(uuid())
  userId   String
  teamId   String
  role     GlobalRole @default(TEAM_MANAGER) // TEAM_MANAGER or TEAM_STAFF
  invitedAt DateTime @default(now())
  acceptedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@map("team_members")
}

// One TeamRegistration per team-per-tournament — this is the record that moves
// through the DRAFT -> SUBMITTED -> ... -> APPROVED/REJECTED state machine.
model TeamRegistration {
  id             String              @id @default(uuid())
  teamId         String
  tournamentId   String
  status         RegistrationStatus  @default(DRAFT)
  managerName    String?
  managerPosition String?
  managerEmail   String?
  managerPhone   String?
  managerCountry String?
  assistantManagerName  String?
  assistantManagerEmail String?
  assistantManagerPhone String?
  submittedAt    DateTime?
  reviewedAt     DateTime?
  approvedAt     DateTime?
  internalNotes  String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  events     RegistrationEvent[]

  @@unique([teamId, tournamentId])
  @@map("team_registrations")
}

// Append-only history of status transitions for a registration (feeds §26 Audit Log
// and the team-facing "Activity" tab in §23).
model RegistrationEvent {
  id                  String   @id @default(uuid())
  teamRegistrationId  String
  fromStatus          RegistrationStatus?
  toStatus            RegistrationStatus
  actorUserId         String?
  note                String?
  createdAt           DateTime @default(now())

  teamRegistration TeamRegistration @relation(fields: [teamRegistrationId], references: [id], onDelete: Cascade)

  @@map("registration_events")
}

model TeamDocument {
  id               String   @id @default(uuid())
  teamId           String
  storageKey       String   @unique
  originalFilename String
  mimeType         String
  size             Int
  visibility       DocumentVisibility @default(PUBLIC) // logos are public; other team docs may be private
  createdAt        DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("team_documents")
}

// ---------- Players ----------

model Player {
  id                    String       @id @default(uuid())
  teamId                String
  firstName             String
  middleName            String?
  lastName              String
  preferredName         String?
  dateOfBirth           DateTime?
  nationality           String?
  countryOfResidence    String?
  gender                String?
  jerseyNumber          Int?
  position              String?      // GOALKEEPER | DEFENDER | MIDFIELDER | FORWARD
  height                Int?         // cm
  phone                 String?
  email                 String?
  emergencyContact      String?
  emergencyContactPhone String?
  status                PlayerStatus @default(DRAFT)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  documents PlayerDocument[]

  @@map("players")
}

model PlayerDocument {
  id               String   @id @default(uuid())
  playerId         String
  documentType     String   // "passport" | "photo" | "eligibility" | "medical" | "consent" | ...
  storageKey       String   @unique
  originalFilename String
  mimeType         String
  size             Int
  visibility       DocumentVisibility @default(PRIVATE)
  changeRequestNote String?  // set when admin requests a replacement (§25)
  createdAt        DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("player_documents")
}

// ---------- Fixtures & Announcements ----------

model Fixture {
  id           String     @id @default(uuid())
  tournamentId String
  venueId      String?
  round        String?
  group        String?
  matchNumber  Int?
  kickoffAt    DateTime?
  teamAId      String?
  teamBId      String?
  scoreA       Int?
  scoreB       Int?
  status       String     @default("SCHEDULED") // SCHEDULED | LIVE | COMPLETED | POSTPONED
  isPublished  Boolean    @default(false)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  venue      Venue?     @relation(fields: [venueId], references: [id])

  @@map("fixtures")
}

model Announcement {
  id           String             @id @default(uuid())
  tournamentId String
  title        String
  body         String
  status       AnnouncementStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime           @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("tournament_announcements")
}

// ---------- Cross-cutting ----------

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String   // e.g. "team.approved", "document.uploaded"
  resourceType String
  resourceId   String
  previousState Json?
  newState     Json?
  ipAddress    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // "registration.approved", "player.changes_requested", ...
  channel   String   @default("email") // email | sms | whatsapp (future)
  payload   Json?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@map("notifications")
}
