# Database
# Matches docker-compose.yml's default Postgres credentials — no edits
# needed if you're using `docker compose up -d db` for local dev.
DATABASE_URL="postgresql://tournament:tournament@localhost:5432/tournament_portal"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Cloudflare R2 (S3-compatible) — server-only, never exposed to the browser
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET="tournament-public"
R2_PRIVATE_BUCKET="tournament-private"
R2_PUBLIC_HOSTNAME="assets.example.com"

# Email (notifications)
EMAIL_FROM="no-reply@example.com"
EMAIL_PROVIDER_API_KEY=

# Rate limiting / Redis (optional at MVP; add when async workloads require it)
REDIS_URL=
